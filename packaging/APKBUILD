source="$pkgname-$pkgver.tar.gz::https://github.com/Spaceghost/zfs-ncdu/archive/refs/tags/v$pkgver.tar.gz"

check() {
	./tests/run.sh
}

package() {
	make install PREFIX=/usr DESTDIR="$pkgdir"
}
