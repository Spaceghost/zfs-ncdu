# Maintainer: Johnneylee Jack Rollins <johnneylee.rollins@gmail.com>
pkgname=zfs-ncdu
pkgver=0.1.0
pkgrel=1
pkgdesc='Browse ZFS space accounting in ncdu'
arch=('any')
url='https://github.com/Spaceghost/zfs-ncdu'
license=('MIT')
depends=('awk')
optdepends=('ncdu: to view the generated export'
            'zfs-utils: to read pools on this machine')
checkdepends=('ncdu' 'python3')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Spaceghost/zfs-ncdu/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
	cd "$pkgname-$pkgver"
	./tests/run.sh
}

package() {
	cd "$pkgname-$pkgver"
	make install PREFIX=/usr DESTDIR="$pkgdir"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
